<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageTags>configuration;secrets;usersecrets;karls</PackageTags>
    <PackAsTool>true</PackAsTool>
    <RollForward>Major</RollForward>
    <ToolCommandName>dotnet-better-secrets</ToolCommandName>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;any</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'any'">false</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSelfContained Condition="'$(RuntimeIdentifier)' == 'any'">false</PublishSelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' == 'any'">false</PublishTrimmed>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Karls.BetterSecretsTool</PackageId>
    <Authors>Karl-Johan Sjögren</Authors>
    <Description>An easy way to manage .NET User Secrets from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <NoWarn>NU5100,NU5119</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="SecretManager.targets" Link="assets\SecretManager.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console.Json" />
  </ItemGroup>

</Project>
