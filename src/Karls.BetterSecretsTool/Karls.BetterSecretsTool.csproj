<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageTags>configuration;secrets;usersecrets;karls</PackageTags>
    <PackAsTool>true</PackAsTool>
    <RollForward>Major</RollForward>
    <ToolCommandName>dotnet-better-secrets</ToolCommandName>
    <PublishNativeAot Condition="'$(PublishNativeAot)' == ''">false</PublishNativeAot>
    <IncludeNativeAotInToolPackage Condition="'$(IncludeNativeAotInToolPackage)' == ''">true</IncludeNativeAotInToolPackage>
    <NativeAotRuntimeIdentifiers>linux-x64;win-x64;osx-x64</NativeAotRuntimeIdentifiers>
    <NativeAotPackageRuntimeIdentifiers Condition="'$(NativeAotPackageRuntimeIdentifiers)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</NativeAotPackageRuntimeIdentifiers>
    <NativeAotPackageRuntimeIdentifiers Condition="'$(NativeAotPackageRuntimeIdentifiers)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</NativeAotPackageRuntimeIdentifiers>
    <NativeAotPackageRuntimeIdentifiers Condition="'$(NativeAotPackageRuntimeIdentifiers)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</NativeAotPackageRuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <_NativeAotOutputRoot Condition="'$(_NativeAotOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\nativeaot\</_NativeAotOutputRoot>
    <PublishDir Condition="'$(RuntimeIdentifier)' != '' and '$(PublishDir)' == ''">$(_NativeAotOutputRoot)$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddNativeAotContentToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Karls.BetterSecretsTool</PackageId>
    <Authors>Karl-Johan Sjögren</Authors>
    <Description>An easy way to manage .NET User Secrets from the command line.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <NoWarn>NU5100,NU5119</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="SecretManager.targets" Link="assets\SecretManager.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console.Json" />
  </ItemGroup>

  <Target Name="ValidateNativeAotPublishConfiguration" BeforeTargets="Publish" Condition="'$(PublishNativeAot)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="RuntimeIdentifier must be set when PublishNativeAot=true." />
  </Target>

  <Target Name="PublishNativeAotForToolPackage" Condition="'$(PackAsTool)' == 'true' and '$(IncludeNativeAotInToolPackage)' == 'true'">
    <PropertyGroup>
      <_NativeAotPackRoot>$(BaseIntermediateOutputPath)nativeaot\</_NativeAotPackRoot>
    </PropertyGroup>

    <ItemGroup>
      <_NativeAotPackageRid Include="$(NativeAotPackageRuntimeIdentifiers)" />
    </ItemGroup>

    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration) --runtime %(_NativeAotPackageRid.Identity) /p:PublishNativeAot=true --output &quot;$(_NativeAotPackRoot)%(_NativeAotPackageRid.Identity)&quot;" />

  </Target>

  <Target Name="AddNativeAotContentToPackage" DependsOnTargets="PublishNativeAotForToolPackage" Condition="'$(PackAsTool)' == 'true' and '$(IncludeNativeAotInToolPackage)' == 'true'">
    <PropertyGroup>
      <_NativeAotPackRoot>$(BaseIntermediateOutputPath)nativeaot\</_NativeAotPackRoot>
    </PropertyGroup>

    <ItemGroup>
      <_NativeAotPackageFiles Include="$(_NativeAotPackRoot)**\*" />
      <TfmSpecificPackageFile Include="@(_NativeAotPackageFiles)">
        <PackagePath>tools/nativeaot/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
